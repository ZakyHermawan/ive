# CHECK-LABEL:   ive.func @main() {
# CHECK:           %[[CONSTANT_0:.*]] = ive.constant dense<1.000000e+00> : tensor<f64>
# CHECK:           %[[CONSTANT_1:.*]] = ive.constant dense<2.000000e+00> : tensor<f64>
# CHECK:           %[[COND0:.*]] = ive.cmp %[[CONSTANT_0]], %[[CONSTANT_1]] {predicate = "lt"} : (tensor<f64>, tensor<f64>) -> i1
# CHECK:           ive.if %[[COND0]] {
# CHECK:             ive.print %[[CONSTANT_0]] : tensor<f64>
# CHECK:             "ive.yield"() : () -> ()
# CHECK:           } else {
# CHECK:             ive.print %[[CONSTANT_1]] : tensor<f64>
# CHECK:             "ive.yield"() : () -> ()
# CHECK:           }
# CHECK:           %[[COND1:.*]] = ive.cmp %[[CONSTANT_1]], %[[CONSTANT_0]] {predicate = "gt"} : (tensor<f64>, tensor<f64>) -> i1
# CHECK:           ive.if %[[COND1]] {
# CHECK:             ive.print %[[CONSTANT_1]] : tensor<f64>
# CHECK:             "ive.yield"() : () -> ()
# CHECK:           }
# CHECK:           ive.return
# CHECK:         }
# JIT: 1.000000
# JIT-NEXT: 2.000000
def main() {
  var a = 1;
  var b = 2;
  if (a < b) {
    print(a);
  }
  else {
    print(b);
  }

  if (b > a) {
    print(b);
  }
}
